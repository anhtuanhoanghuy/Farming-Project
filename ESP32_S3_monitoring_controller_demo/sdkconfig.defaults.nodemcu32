# Bench-only target: NodeMCU ESP32S (classic ESP32, 4 MB flash). Not for production.
CONFIG_IDF_TARGET="esp32"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT=y

CONFIG_ESP_BROWNOUT_DET=y

# Bench W5500 and public development MQTT broker; never use for production.
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_APP_MQTT_BROKER_URI="mqtt://103.98.150.157:1883"
CONFIG_APP_MQTT_ALLOW_PLAINTEXT=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Keep the system wall clock current with one SNTP refresh per hour.
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
